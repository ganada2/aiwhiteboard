{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build (GCC/OSS)",
            "type": "shell",
            "command": "gcc",
            "args": [
                "-Wall",
                "-Wextra",
                "-std=c99",
                "-o",
                "card_auth_server.exe",
                "card_auth.c",
                "pathway_main.c",
                "pathway_req.c",
                "pathway_resp.c",
                "host_link.c"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "clean",
            "type": "shell",
            "command": "cmd",
            "args": [
                "/c",
                "del /Q *.o card_auth_server.exe 2>nul"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            }
        }
    ]
}